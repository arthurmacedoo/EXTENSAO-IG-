{
  "manifest_version": 3,
  "name": "IG Live - Captura Profissional de Comentários",
  "version": "2.0.0",
  "description": "Captura ultra-robusta de comentários para Live Commerce com arquitetura híbrida (REST + DOM), persistência IndexedDB e proteção anti-perda.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG Live Captura"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["db.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
