{
  "manifest_version": 3,
  "name": "IG Live - Captura Profissional de Comentários",
  "version": "2.1.0",
  "description": "Captura ultra-robusta de comentários para Live Commerce com arquitetura híbrida (REST + DOM), persistência IndexedDB e proteção anti-perda.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://instagram.com/*",
    "*://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.vercel.app/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG Live Captura",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://instagram.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://instagram.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["db.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
